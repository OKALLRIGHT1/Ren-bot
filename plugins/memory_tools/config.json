{
  "name": "记忆与画像查询",
  "trigger": "memory_tools",
  "llm_command": "memory_tools",
  "type": "delegate",
  "aliases": ["/memory", "/记忆"],
  "direct_command_aliases": ["/memory", "/记忆"],
  "description": "查询长期记忆、人物画像和本地活动统计。参数：query/profile/activity ||| 自然语言问题",
